# ---- Java / Maven (backend) ----
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Node / Vue (frontend) ----
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
*.local

# ---- 环境变量与密钥（.env.example 是样例，必须提交）----
.env
.env.*
!.env.example

# ---- 日志 ----
logs/
*.log

# ---- IDE ----
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 桌面部署器（deployer, Tauri）----
deployer/node_modules/
deployer/dist/
deployer/src-tauri/target/
deployer/src-tauri/gen/

# 本地冒烟测试临时数据
.smoke/

# 本地调试截图（浏览器验证/导出弹窗等临时产物）
.playwright-mcp/
gui-test-screenshots/
*.png

# 例外：上面的全局 *.png 规则会误伤 Tauri 构建必需的图标，显式救回
# （gitignore 按最后匹配优先，此规则必须保持在 *.png 之后）
!deployer/src-tauri/icons/**
